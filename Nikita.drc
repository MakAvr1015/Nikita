	dxSpreadSheetFunctionsStrs_sfnCoupDayBS,	L"COUPDAYBS"
	dxSpreadSheetFunctionsStrs_sfnCoupDayBSDescription,	L"Returns the number of days from the beginning of the coupon period to the settlement date."
	dxSpreadSheetFunctionsStrs_sfnCoupDays,	L"COUPDAYS"

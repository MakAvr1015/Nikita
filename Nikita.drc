	dxSpreadSheetFunctionsStrs_sfnOddFYield,	L"ODDFYIELD"
	dxSpreadSheetFunctionsStrs_sfnOddFYieldDescription,	L"Returns the yield of a security with an odd first period."
	dxSpreadSheetFunctionsStrs_sfnOddLPrice,	L"ODDLPRICE"

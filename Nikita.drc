	dxSpreadSheetFunctionsStrs_sfnDB,	L"DB"
	dxSpreadSheetFunctionsStrs_sfnDBDescription,	L"Returns the depreciation of an asset for a specified period by using the fixed-declining balance method."
	dxSpreadSheetFunctionsStrs_sfnDDB,	L"DDB"

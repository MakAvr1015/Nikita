	dxSpreadSheetFunctionsStrs_sfnYieldMatDescription,	L"Returns the annual yield of a security that pays interest at maturity."
	dxSpreadSheetFunctionsStrs_sfnAnd,	L"AND"
	dxSpreadSheetFunctionsStrs_sfnAndDescription,	L"Performs the logical AND operation."
	dxSpreadSheetFunctionsStrs_sfnPV,	L"PV"
	dxSpreadSheetFunctionsStrs_sfnPVDescription,	L"Calculates the present value of an investment (i.e., the total amount that a series of future payments is worth now)."
	dxSpreadSheetFunctionsStrs_sfnRate,	L"RATE"
	dxSpreadSheetFunctionsStrs_sfnRateDescription,	L"Calculates the interest rate required to pay off a specified amount of a loan, or reach a target amount on an investment over a given period."
	dxSpreadSheetFunctionsStrs_sfnReceived,	L"RECEIVED"
	dxSpreadSheetFunctionsStrs_sfnReceivedDescription,	L"Returns the amount received at maturity for a fully invested security."
	dxSpreadSheetFunctionsStrs_sfnRRI,	L"RRI"
	dxSpreadSheetFunctionsStrs_sfnRRIDescription,	L"Returns an equivalent interest rate for the growth of an investment."
	dxSpreadSheetFunctionsStrs_sfnSLN,	L"SLN"
	dxSpreadSheetFunctionsStrs_sfnSLNDescription,	L"Returns the straight-line depreciation of an asset for one period."
	dxSpreadSheetFunctionsStrs_sfnSYD,	L"SYD"
	dxSpreadSheetFunctionsStrs_sfnSYDDescription,	L"Returns the sum-of-years' digits depreciation of an asset for a specified period."
	dxSpreadSheetFunctionsStrs_sfnTBillEq,	L"TBILLEQ"
	dxSpreadSheetFunctionsStrs_sfnTBillEqDescription,	L"Returns the bond-equivalent yield for a Treasury bill."
	dxSpreadSheetFunctionsStrs_sfnTBillPrice,	L"TBILLPRICE"
	dxSpreadSheetFunctionsStrs_sfnTBillPriceDescription,	L"Returns the price per $100 face value for a Treasury bill."
	dxSpreadSheetFunctionsStrs_sfnOddLPrice,	L"ODDLPRICE"
	dxSpreadSheetFunctionsStrs_sfnOddLPriceDescription,	L"Returns the price per $100 face value of a security with an odd last period."
	dxSpreadSheetFunctionsStrs_sfnOddLYield,	L"ODDLYIELD"
	dxSpreadSheetFunctionsStrs_sfnOddLYieldDescription,	L"Returns the yield of a security with an odd last period."
	dxSpreadSheetFunctionsStrs_sfnPDuration,	L"PDURATION"
	dxSpreadSheetFunctionsStrs_sfnPDurationDescription,	L"Returns the number of periods required by an investment to reach a specified value."
	dxSpreadSheetFunctionsStrs_sfnPMT,	L"PMT"
	dxSpreadSheetFunctionsStrs_sfnPMTDescription,	L"Calculates the payments required to reduce a loan, from a supplied present value to a specified future value."
	dxSpreadSheetFunctionsStrs_sfnPPMT,	L"PPMT"
	dxSpreadSheetFunctionsStrs_sfnPPMTDescription,	L"Calculates the payment on the principal for a given investment, with periodic constant payments and a constant interest rate."
	dxSpreadSheetFunctionsStrs_sfnPrice,	L"PRICE"
	dxSpreadSheetFunctionsStrs_sfnPriceDescription,	L"Returns the price per $100 face value of a security that pays a periodic interest."
	dxSpreadSheetFunctionsStrs_sfnPriceDisc,	L"PRICEDISC"
	dxSpreadSheetFunctionsStrs_sfnPriceDiscDescription,	L"Returns the price per $100 face value of a discounted security."
	dxSpreadSheetFunctionsStrs_sfnPriceMat,	L"PRICEMAT"
	dxSpreadSheetFunctionsStrs_sfnPriceMatDescription,	L"Returns the price per $100 face value of a security that pays interest at maturity."
	dxSpreadSheetFunctionsStrs_sfnIsPMT,	L"ISPMT"
	dxSpreadSheetFunctionsStrs_sfnIsPMTDescription,	L"Calculates the interest paid during a specific period of an investment."
	dxSpreadSheetFunctionsStrs_sfnMDuration,	L"MDURATION"
	dxSpreadSheetFunctionsStrs_sfnMDurationDescription,	L"Returns the Macauley modified duration for a security with an assumed par value of $100."
	dxSpreadSheetFunctionsStrs_sfnMIRR,	L"MIRR"
	dxSpreadSheetFunctionsStrs_sfnMIRRDescription,	L"Calculates the internal rate of return for a series of periodic cash flows, considering the cost of the investment and the interest on the reinvestment of cash."
	dxSpreadSheetFunctionsStrs_sfnNominal,	L"NOMINAL"
	dxSpreadSheetFunctionsStrs_sfnNominalDescription,	L"Returns the annual nominal interest rate."
	dxSpreadSheetFunctionsStrs_sfnNPer,	L"NPER"
	dxSpreadSheetFunctionsStrs_sfnNPerDescription,	L"Returns the number of periods for an investment with periodic constant payments and a constant interest rate."
	dxSpreadSheetFunctionsStrs_sfnNPV,	L"NPV"
	dxSpreadSheetFunctionsStrs_sfnNPVDescription,	L"Calculates the net present value of an investment, based on a supplied discount rate, and a series of future payments and income."
	dxSpreadSheetFunctionsStrs_sfnOddFPrice,	L"ODDFPRICE"
	dxSpreadSheetFunctionsStrs_sfnOddFPriceDescription,	L"Returns the price per $100 face value of a security with an odd first period."
	dxSpreadSheetFunctionsStrs_sfnOddFYield,	L"ODDFYIELD"
	dxSpreadSheetFunctionsStrs_sfnOddFYieldDescription,	L"Returns the yield of a security with an odd first period."
	dxSpreadSheetFunctionsStrs_sfnDollarFr,	L"DOLLARFR"
	dxSpreadSheetFunctionsStrs_sfnDollarFrDescription,	L"Converts a dollar price, expressed as a decimal number, into a dollar price, expressed as a fraction."
	dxSpreadSheetFunctionsStrs_sfnDuration,	L"DURATION"
	dxSpreadSheetFunctionsStrs_sfnDurationDescription,	L"Returns the annual duration of a security with periodic interest payments."
	dxSpreadSheetFunctionsStrs_sfnEffect,	L"EFFECT"
	dxSpreadSheetFunctionsStrs_sfnEffectDescription,	L"Returns the effective annual interest rate."
	dxSpreadSheetFunctionsStrs_sfnFV,	L"FV"
	dxSpreadSheetFunctionsStrs_sfnFVDescription,	L"Calculates the future value of an investment with periodic constant payments and a constant interest rate."
	dxSpreadSheetFunctionsStrs_sfnFVSchedule,	L"FVSCHEDULE"
	dxSpreadSheetFunctionsStrs_sfnFVScheduleDescription,	L"Returns the future value of an initial principal after applying a series of compound interest rates."
	dxSpreadSheetFunctionsStrs_sfnIntRate,	L"INTRATE"
	dxSpreadSheetFunctionsStrs_sfnIntRateDescription,	L"Returns the interest rate for a fully invested security."
	dxSpreadSheetFunctionsStrs_sfnIPMT,	L"IPMT"
	dxSpreadSheetFunctionsStrs_sfnIPMTDescription,	L"Calculates the interest payment for a given period of an investment, with periodic constant payments and a constant interest rate."
	dxSpreadSheetFunctionsStrs_sfnIRR,	L"IRR"
	dxSpreadSheetFunctionsStrs_sfnIRRDescription,	L"Calculates the internal rate of return for a series of cash flows."
	dxSpreadSheetFunctionsStrs_sfnCoupNum,	L"COUPNUM"
	dxSpreadSheetFunctionsStrs_sfnCoupNumDescription,	L"Returns the number of coupons payable between the settlement date and maturity date."
	dxSpreadSheetFunctionsStrs_sfnCoupPCD,	L"COUPPCD"
	dxSpreadSheetFunctionsStrs_sfnCoupPCDDescription,	L"Returns the previous coupon date before the settlement date."
	dxSpreadSheetFunctionsStrs_sfnCoupIPMT,	L"CUMIPMT"
	dxSpreadSheetFunctionsStrs_sfnCoupIPMTDescription,	L"Calculates the cumulative interest paid between two specified periods."
	dxSpreadSheetFunctionsStrs_sfnCoupRINC,	L"CUMPRINC"
	dxSpreadSheetFunctionsStrs_sfnCoupRINCDescription,	L"Calculates the cumulative principal paid on a loan, between two specified periods."
	dxSpreadSheetFunctionsStrs_sfnDB,	L"DB"
	dxSpreadSheetFunctionsStrs_sfnDBDescription,	L"Returns the depreciation of an asset for a specified period by using the fixed-declining balance method."
	dxSpreadSheetFunctionsStrs_sfnDDB,	L"DDB"
	dxSpreadSheetFunctionsStrs_sfnDDBDescription,	L"Returns the depreciation of an asset for a specified period by using the double-declining balance method or some other method that you specify."
	dxSpreadSheetFunctionsStrs_sfnDisc,	L"DISC"
	dxSpreadSheetFunctionsStrs_sfnDiscDescription,	L"Returns the discount rate for a security."
	dxSpreadSheetFunctionsStrs_sfnDollarDe,	L"DOLLARDE"
	dxSpreadSheetFunctionsStrs_sfnDollarDeDescription,	L"Converts a dollar price, expressed as a fraction, into a dollar price, expressed as a decimal number."
	dxSpreadSheetFunctionsStrs_sfnAccrInt,	L"ACCRINT"
	dxSpreadSheetFunctionsStrs_sfnAccrIntDescription,	L"Returns the accrued interest for a security that pays a periodic interest."
	dxSpreadSheetFunctionsStrs_sfnAccrIntM,	L"ACCRINTM"
	dxSpreadSheetFunctionsStrs_sfnAccrIntMDescription,	L"Returns the accrued interest for a security that pays at maturity."
	dxSpreadSheetFunctionsStrs_sfnAmorDegr,	L"AMORDEGRC"
	dxSpreadSheetFunctionsStrs_sfnAmorDegrDescription,	L"Returns the depreciation of an asset for each accounting period. This function is provided for the French accounting system."
	dxSpreadSheetFunctionsStrs_sfnAmorLinc,	L"AMORLINC"
	dxSpreadSheetFunctionsStrs_sfnAmorLincDescription,	L"Returns the depreciation for each accounting period."
	dxSpreadSheetFunctionsStrs_sfnCoupDayBS,	L"COUPDAYBS"
	dxSpreadSheetFunctionsStrs_sfnCoupDayBSDescription,	L"Returns the number of days from the beginning of the coupon period to the settlement date."
	dxSpreadSheetFunctionsStrs_sfnCoupDays,	L"COUPDAYS"
	dxSpreadSheetFunctionsStrs_sfnCoupDaysDescription,	L"Returns the number of days in the coupon period that contains the settlement date."
	dxSpreadSheetFunctionsStrs_sfnCoupDaysNC,	L"COUPDAYSNC"
	dxSpreadSheetFunctionsStrs_sfnCoupDaysNCDescription,	L"Returns the number of days from the settlement date to the next coupon date."
	dxSpreadSheetFunctionsStrs_sfnCoupNCD,	L"COUPNCD"
	dxSpreadSheetFunctionsStrs_sfnCoupNCDDescription,	L"Returns the next coupon date after the settlement date."
	dxSpreadSheetFunctionsStrs_sfnTimeValue,	L"TIMEVALUE"
	dxSpreadSheetFunctionsStrs_sfnTimeValueDescription,	L"Converts a text time representation into a date/time value."
	dxSpreadSheetFunctionsStrs_sfnToday,	L"TODAY"
	dxSpreadSheetFunctionsStrs_sfnTodayDescription,	L"Returns the serial number corresponding to the current date."
	dxSpreadSheetFunctionsStrs_sfnWeekDay,	L"WEEKDAY"
	dxSpreadSheetFunctionsStrs_sfnWeekDayDescription,	L"Returns the day of the week corresponding to the specified date value."
	dxSpreadSheetFunctionsStrs_sfnWeekNum,	L"WEEKNUM"
	dxSpreadSheetFunctionsStrs_sfnWeekNumDescription,	L"Returns the week number corresponding to the specified date."
	dxSpreadSheetFunctionsStrs_sfnWorkDay,	L"WORKDAY"
	dxSpreadSheetFunctionsStrs_sfnWorkDayDescription,	L"Returns the workday separated from the initial date by the specified number of workdays. The returned day precedes or follows the initial date, depending on the day count\x2019s sign."
	dxSpreadSheetFunctionsStrs_sfnWorkDay_Intl,	L"WORKDAY.INTL"
	dxSpreadSheetFunctionsStrs_sfnWorkDay_IntlDescription,	L"Returns the serial number of the date before or after the specified number of workdays, taking a custom set of holidays into account."
	dxSpreadSheetFunctionsStrs_sfnYear,	L"YEAR"
	dxSpreadSheetFunctionsStrs_sfnYearDescription,	L"Returns the serial number corresponding to the specified year."
	dxSpreadSheetFunctionsStrs_sfnYearFrac,	L"YEARFRAC"
	dxSpreadSheetFunctionsStrs_sfnYearFracDescription,	L"Calculates the fraction of the year within the range between two specified dates."
	dxSpreadSheetFunctionsStrs_sfnIsoWeekNum,	L"ISOWEEKNUM"
	dxSpreadSheetFunctionsStrs_sfnIsoWeekNumDescription,	L"Returns the ISO number of the week to which the specified date belongs."
	dxSpreadSheetFunctionsStrs_sfnMinute,	L"MINUTE"
	dxSpreadSheetFunctionsStrs_sfnMinuteDescription,	L"Converts a serial number to the corresponding minute."
	dxSpreadSheetFunctionsStrs_sfnMonth,	L"MONTH"
	dxSpreadSheetFunctionsStrs_sfnMonthDescription,	L"Converts a serial number to the corresponding month."
	dxSpreadSheetFunctionsStrs_sfnNetworkDays,	L"NETWORKDAYS"
	dxSpreadSheetFunctionsStrs_sfnNetworkDaysDescription,	L"This function is useful for calculating employee benefits that accrue based on the number of days worked under specific terms."
	dxSpreadSheetFunctionsStrs_sfnNetworkDays_Intl,	L"NETWORKDAYS.INTL"
	dxSpreadSheetFunctionsStrs_sfnNetworkDays_IntlDescription,	L"Returns the number of whole workdays between two specified dates."
	dxSpreadSheetFunctionsStrs_sfnNow,	L"NOW"
	dxSpreadSheetFunctionsStrs_sfnNowDescription,	L"Returns the current time as a date/time value."
	dxSpreadSheetFunctionsStrs_sfnSecond,	L"SECOND"
	dxSpreadSheetFunctionsStrs_sfnSecondDescription,	L"Converts a serial number to the corresponding second."
	dxSpreadSheetFunctionsStrs_sfnTime,	L"TIME"
	dxSpreadSheetFunctionsStrs_sfnTimeDescription,	L"Converts the specified time to the corresponding serial number."
	dxSpreadSheetFunctionsStrs_sfnDate,	L"DATE"
	dxSpreadSheetFunctionsStrs_sfnDateDescription,	L"Calculates the serial number corresponding to the specified date."
	dxSpreadSheetFunctionsStrs_sfnDateValue,	L"DATEVALUE"
	dxSpreadSheetFunctionsStrs_sfnDateValueDescription,	L"Converts a date specified as a text string to the corresponding serial number."
	dxSpreadSheetFunctionsStrs_sfnDay,	L"DAY"
	dxSpreadSheetFunctionsStrs_sfnDayDescription,	L"Converts a serial number to the corresponding date (day)."
	dxSpreadSheetFunctionsStrs_sfnDays,	L"DAYS"
	dxSpreadSheetFunctionsStrs_sfnDaysDescription,	L"Returns the number of days between two specified dates."
	dxSpreadSheetFunctionsStrs_sfnDays360,	L"DAYS360"
	dxSpreadSheetFunctionsStrs_sfnDays360Description,	L"Returns the number of days between two specified dates based on a 360-day year (that includes twelve 30-day months), which is used in some accounting calculations."
	dxSpreadSheetFunctionsStrs_sfnEDate,	L"EDATE"
	dxSpreadSheetFunctionsStrs_sfnEDateDescription,	L"Returns the serial number of the date that is the indicated number of months before or after the start date."
	dxSpreadSheetFunctionsStrs_sfnEOMonth,	L"EOMONTH"
	dxSpreadSheetFunctionsStrs_sfnEOMonthDescription,	L"Returns the serial number of the last day of the month before or after a specified number of months."
	dxSpreadSheetFunctionsStrs_sfnHour,	L"HOUR"
	dxSpreadSheetFunctionsStrs_sfnHourDescription,	L"Converts a serial number to the corresponding hour."
	dxSpreadSheetFunctionsStrs_sfnStDevP,	L"STDEVP"
	dxSpreadSheetFunctionsStrs_sfnStDevPDescription,	L"Calculates the standard deviation based on the entire population specified as an array of numeric values. The standard deviation indicates how widely values within a series of numbers disperse from the average value (that is, the mean)."
	dxSpreadSheetFunctionsStrs_sfnTDist,	L"TDIST"
	dxSpreadSheetFunctionsStrs_sfnTDistDescription,	L"Returns the Percentage Points (that is, the probability) for the Student T-distribution. The T-distribution is used in the hypothesis testing of small sample data sets."
	dxSpreadSheetFunctionsStrs_sfnTInv,	L"TINV"
	dxSpreadSheetFunctionsStrs_sfnTInvDescription,	L"Iteratively calculates the two-tailed inverse of the Student\x2019s T-distribution."
	dxSpreadSheetFunctionsStrs_sfnTTest,	L"TTEST"
	dxSpreadSheetFunctionsStrs_sfnTTestDescription,	L"Returns the probability associated with a Student\x2019s T-test."
	dxSpreadSheetFunctionsStrs_sfnVar,	L"VAR"
	dxSpreadSheetFunctionsStrs_sfnVarDescription,	L"Estimates variance based on the specified array of numeric values (a sample of the population)."
	dxSpreadSheetFunctionsStrs_sfnVarP,	L"VARP"
	dxSpreadSheetFunctionsStrs_sfnVarPDescription,	L"Calculates variance based on the entire population specified as an array of numeric values."
	dxSpreadSheetFunctionsStrs_sfnWeibull,	L"WEIBULL"
	dxSpreadSheetFunctionsStrs_sfnWeibullDescription,	L"Returns the Weibull distribution used in reliability analysis. You can use this function to calculate a device\x2019s MBTF (mean time between failures)."
	dxSpreadSheetFunctionsStrs_sfnZTest,	L"ZTEST"
	dxSpreadSheetFunctionsStrs_sfnZTestDescription,	L"Returns the one-tailed probability associated with a Z-test, that is the probability that the sample mean is greater than the average of all numeric values in the source array."
	dxSpreadSheetFunctionsStrs_sfnNormSDist,	L"NORMSDIST"
	dxSpreadSheetFunctionsStrs_sfnNormSDistDescription,	L"Returns the standard normal cumulative distribution function. The standard distribution\x2019s arithmetic mean and standard deviation are 0 and 1, respectively."
	dxSpreadSheetFunctionsStrs_sfnNormSInv,	L"NORMSINV"
	dxSpreadSheetFunctionsStrs_sfnNormSInvDescription,	L"Iteratively calculates the inverse of the standard normal cumulative distribution. The standard distribution\x2019s arithmetic mean and standard deviation are 0 and 1, respectively."
	dxSpreadSheetFunctionsStrs_sfnPercentile,	L"PERCENTILE"
	dxSpreadSheetFunctionsStrs_sfnPercentileDescription,	L"Returns the K-th percentile of values in an array of numbers."
	dxSpreadSheetFunctionsStrs_sfnPercentRank,	L"PERCENTRANK"
	dxSpreadSheetFunctionsStrs_sfnPercentRankDescription,	L"Returns the percentage rank of the specified value in an array of numbers."
	dxSpreadSheetFunctionsStrs_sfnPoisson,	L"POISSON"
	dxSpreadSheetFunctionsStrs_sfnPoissonDescription,	L"Returns the Poisson distribution that is often used to predict the number of events occurring over a specific time."
	dxSpreadSheetFunctionsStrs_sfnQuartile,	L"QUARTILE"
	dxSpreadSheetFunctionsStrs_sfnQuartileDescription,	L"Returns the quartile of a series of numeric values."
	dxSpreadSheetFunctionsStrs_sfnRank,	L"RANK"
	dxSpreadSheetFunctionsStrs_sfnRankDescription,	L"Returns the rank of a specific number in a series of values. The rank is a magnitude of a numeric value in relation to all other values in the source array. This rank matches the value\x2019s number in a sorted array."
	dxSpreadSheetFunctionsStrs_sfnStDev,	L"STDEV"
	dxSpreadSheetFunctionsStrs_sfnStDevDescription,	L"Estimates the standard deviation based on the specified array of numeric values (a sample of the population). The standard deviation indicates how widely values within a series of numbers disperse from the average value (that is, the mean)."
	dxSpreadSheetFunctionsStrs_sfnGammaInv,	L"GAMMAINV"
	dxSpreadSheetFunctionsStrs_sfnGammaInvDescription,	L"Iteratively calculates the inverse of the gamma cumulative distribution. The gamma distribution is useful to study values that have a skewed distribution."
	dxSpreadSheetFunctionsStrs_sfnHypgeomDist,	L"HYPGEOMDIST"
	dxSpreadSheetFunctionsStrs_sfnHypgeomDistDescription,	L"Returns the hypergeometric distribution, that is, the probability of a specified number of sample successes at a specific sample size, number of population successes, and population size."
	dxSpreadSheetFunctionsStrs_sfnLogInv,	L"LOGINV"
	dxSpreadSheetFunctionsStrs_sfnLogInvDescription,	L"Calculates the inverse of the lognormal cumulative distribution."
	dxSpreadSheetFunctionsStrs_sfnLogNormDist,	L"LOGNORMDIST"
	dxSpreadSheetFunctionsStrs_sfnLogNormDistDescription,	L"Returns the cumulative lognormal distribution."
	dxSpreadSheetFunctionsStrs_sfnMode,	L"MODE"
	dxSpreadSheetFunctionsStrs_sfnModeDescription,	L"Calculates the mode of a group of numbers, that is, returns the most frequently occurring (repetitive) value among all specified numeric values."
	dxSpreadSheetFunctionsStrs_sfnNegBinomDist,	L"NEGBINOMDIST"
	dxSpreadSheetFunctionsStrs_sfnNegBinomDistDescription,	L"Returns the negative binomial distribution, that is, the probability that there is a specific number of failures prior achieving a threshold number of successful trials at the constant probability of a success."
	dxSpreadSheetFunctionsStrs_sfnNormDist,	L"NORMDIST"
	dxSpreadSheetFunctionsStrs_sfnNormDistDescription,	L"Returns the normal distribution for the specified mean and standard distribution. This function is widely used in statistics, including hypothesis testing."
	dxSpreadSheetFunctionsStrs_sfnNormInv,	L"NORMINV"
	dxSpreadSheetFunctionsStrs_sfnNormInvDescription,	L"Iteratively calculates the inverse of the normal distribution of the specified mean and standard deviation."
	dxSpreadSheetFunctionsStrs_sfnChiTestDescription,	L"Returns the test for independence as the value from the chi-squared distribution for the statistic and the appropriate degrees of freedom. You can use this function to identify if the specified hypothetic results are verified by an experiment."
	dxSpreadSheetFunctionsStrs_sfnConfidence,	L"CONFIDENCE"
	dxSpreadSheetFunctionsStrs_sfnCovar,	L"COVAR"
	dxSpreadSheetFunctionsStrs_sfnCovarDescription,	L"Calculates the average of the products of deviations (that is, covariance) for each pair of values in the specified arrays of integers. You can use this function to identify the relationship between two sets of values."
	dxSpreadSheetFunctionsStrs_sfnCritBinom,	L"CRITBINOM"
	dxSpreadSheetFunctionsStrs_sfnCritBinomDescription,	L"Calculates the lowest value for which the cumulative binomial distribution is equal to or greater than a specific value."
	dxSpreadSheetFunctionsStrs_sfnExponDist,	L"EXPONDIST"
	dxSpreadSheetFunctionsStrs_sfnExponDistDescription,	L"Returns the exponential distribution. This function is useful if you need to evaluate the process duration probabilities."
	dxSpreadSheetFunctionsStrs_sfnFDist,	L"FDIST"
	dxSpreadSheetFunctionsStrs_sfnFDistDescription,	L"Returns the right-tailed F probability distribution. This function is useful if you need to identify if two data sets have different degrees of diversity."
	dxSpreadSheetFunctionsStrs_sfnFInv,	L"FINV"
	dxSpreadSheetFunctionsStrs_sfnFInvDescription,	L"Returns the inverse of the right-tailed F probability distribution. You can use the calculated result in an F-test to compare the degree of variability in two data sets."
	dxSpreadSheetFunctionsStrs_sfnFTest,	L"FTEST"
	dxSpreadSheetFunctionsStrs_sfnFTestDescription,	L"Performs an F-test for two specified sets (arrays) of numeric values, returning the two-tailed probability that the variances in both arrays are similar."
	dxSpreadSheetFunctionsStrs_sfnGammaDist,	L"GAMMADIST"
	dxSpreadSheetFunctionsStrs_sfnGammaDistDescription,	L"Returns the gamma distribution. You can use this function to study a series of numbers that may have a skewed distribution. The gamma distribution is commonly used in queuing analysis."
	dxSpreadSheetFunctionsStrs_sfnVarPADescription,	L"Calculates the variance based on the entire population specified as an array, including numeric values, text, and logical values."
	dxSpreadSheetFunctionsStrs_sfnWeibull_Dist,	L"WEIBULL.DIST"
	dxSpreadSheetFunctionsStrs_sfnWeibull_DistDescription,	L"Returns the Weibull distribution used in reliability analysis. You can use this function to calculate a device\x2019s MBTF (mean time between failures)."
	dxSpreadSheetFunctionsStrs_sfnZ_Test,	L"Z.TEST"
	dxSpreadSheetFunctionsStrs_sfnZ_TestDescription,	L"Returns the one-tailed probability associated with a Z-test, that is the probability that the sample mean is greater than the average of all numeric values in the source array."
	dxSpreadSheetFunctionsStrs_sfnBetaDist,	L"BETADIST"
	dxSpreadSheetFunctionsStrs_sfnBetaDistDescription,	L"Returns the cumulative beta probability density function. The beta distribution is useful to study variation of a specific indicator (as a percentage) across samples."
	dxSpreadSheetFunctionsStrs_sfnBetaInv,	L"BETAINV"
	dxSpreadSheetFunctionsStrs_sfnBetaInvDescription,	L"Returns the inverse of the cumulative beta probability density function for the specified beta distribution probability."
	dxSpreadSheetFunctionsStrs_sfnBinomDist,	L"BINOMDIST"
	dxSpreadSheetFunctionsStrs_sfnBinomDistDescription,	L"Returns the individual term binominal distribution probability. You can use this function to evaluate a mixed number of independent trials that can result only in success or failure, provided that the probability of success does not change throughout the experiment."
	dxSpreadSheetFunctionsStrs_sfnChiDist,	L"CHIDIST"
	dxSpreadSheetFunctionsStrs_sfnChiDistDescription,	L"Returns the two-tailed probability of the chi-squared distribution. You can use this function to calculate the variation of a certain indicator across the experimental data."
	dxSpreadSheetFunctionsStrs_sfnChiInv,	L"CHIINV"
	dxSpreadSheetFunctionsStrs_sfnChiInvDescription,	L"Iteratively calculates the inverse of the right-tailed probability of the chi-squared distribution."
	dxSpreadSheetFunctionsStrs_sfnChiTest,	L"CHITEST"
	dxSpreadSheetFunctionsStrs_sfnT_InvDescription,	L"Returns the T-value of the Student\x2019s T-distribution as a function of the probability and the degrees of freedom."
	dxSpreadSheetFunctionsStrs_sfnT_Inv_2T,	L"T.INV.2T"
	dxSpreadSheetFunctionsStrs_sfnT_Inv_2TDescription,	L"Iteratively calculates the two-tailed inverse of the Student\x2019s T-distribution."
	dxSpreadSheetFunctionsStrs_sfnT_Test,	L"T.TEST"
	dxSpreadSheetFunctionsStrs_sfnT_TestDescription,	L"Returns the probability associated with a Student\x2019s T-test."
	dxSpreadSheetFunctionsStrs_sfnTrend,	L"TREND"
	dxSpreadSheetFunctionsStrs_sfnTrendDescription,	L"Returns values along a linear trend."
	dxSpreadSheetFunctionsStrs_sfnTrimMean,	L"TRIMMEAN"
	dxSpreadSheetFunctionsStrs_sfnTrimMeanDescription,	L"Returns the mean of the interior of a series of numeric values. The function calculates the mean from an array whose top and bottom tails are excluded."
	dxSpreadSheetFunctionsStrs_sfnVar_P,	L"VAR.P"
	dxSpreadSheetFunctionsStrs_sfnVar_PDescription,	L"Calculates the variance based on the entire population specified as an array of numeric values."
	dxSpreadSheetFunctionsStrs_sfnVar_S,	L"VAR.S"
	dxSpreadSheetFunctionsStrs_sfnVar_SDescription,	L"Estimates variance based on the specified array of numeric values (a sample of the population)."
	dxSpreadSheetFunctionsStrs_sfnVarA,	L"VARA"
	dxSpreadSheetFunctionsStrs_sfnVarADescription,	L"Estimates variance based on the specified array (a sample of the population), including numeric values, text, and logical values."
	dxSpreadSheetFunctionsStrs_sfnVarPA,	L"VARPA"
	dxSpreadSheetFunctionsStrs_sfnStDev_PDescription,	L"Calculates the standard deviation based on the entire population passed as an array of numeric values. The standard deviation indicates how widely values within a series of numbers disperse from the average value (that is, the mean)."
	dxSpreadSheetFunctionsStrs_sfnStDev_S,	L"STDEV.S"
	dxSpreadSheetFunctionsStrs_sfnStDev_SDescription,	L"Estimates the standard deviation based on the specified array of numeric values (a sample of the population). The standard deviation indicates how widely values within a series of numbers disperse from the average value (that is, the mean)."
	dxSpreadSheetFunctionsStrs_sfnStDevA,	L"STDEVA"
	dxSpreadSheetFunctionsStrs_sfnStDevADescription,	L"Estimates the standard deviation based on the specified array (a sample of the population), including numeric values, text, and logical values."
	dxSpreadSheetFunctionsStrs_sfnStDevPA,	L"STDEVPA"
	dxSpreadSheetFunctionsStrs_sfnStDevPADescription,	L"Calculates the standard deviation based on the entire population passed as an array, including numeric values, text, and logical values."
	dxSpreadSheetFunctionsStrs_sfnSTEYX,	L"STEYX"
	dxSpreadSheetFunctionsStrs_sfnSTEYXDescription,	L"Returns the standard error of the predicted Y-value for each X in the regression. The standard error is a measure of the amount of error in the prediction of Y for an individual X."
	dxSpreadSheetFunctionsStrs_sfnT_Dist,	L"T.DIST"
	dxSpreadSheetFunctionsStrs_sfnT_DistDescription,	L"Returns the Percentage Points (that is, the probability) for the Student\x2019s T-distribution. The T-distribution is used in the hypothesis testing of small sample data sets."
	dxSpreadSheetFunctionsStrs_sfnT_Dist_2T,	L"T.DIST.2T"
	dxSpreadSheetFunctionsStrs_sfnT_Dist_2TDescription,	L"Returns the two-tailed Student\x2019s T-distribution. You can use this function instead of a table of critical values for the T-distribution."
	dxSpreadSheetFunctionsStrs_sfnT_Dist_RT,	L"T.DIST.RT"
	dxSpreadSheetFunctionsStrs_sfnT_Dist_RTDescription,	L"Returns the right-tailed T-distribution."
	dxSpreadSheetFunctionsStrs_sfnT_Inv,	L"T.INV"
	dxSpreadSheetFunctionsStrs_sfnRank_AvgDescription,	L"Returns the rank of a specified number in a series of values. The number\x2019s rank (magnitude) is relative to other values in the list. The function returns the average rank if more than one value has the same rank."
	dxSpreadSheetFunctionsStrs_sfnRank_Eq,	L"RANK.EQ"
	dxSpreadSheetFunctionsStrs_sfnRank_EqDescription,	L"Returns the rank of a specified number in a series of values. The rank is a magnitude of a numeric value in relation to all other values in the source array. The rank matches the value\x2019s number in the sorted array."
	dxSpreadSheetFunctionsStrs_sfnRSQ,	L"RSQ"
	dxSpreadSheetFunctionsStrs_sfnRSQDescription,	L"Returns the square of the Pearson product moment correlation coefficient through data points."
	dxSpreadSheetFunctionsStrs_sfnSkew,	L"SKEW"
	dxSpreadSheetFunctionsStrs_sfnSkewDescription,	L"Returns the skewness of a distribution. Skewness characterizes the degree of asymmetry of a distribution around its mean."
	dxSpreadSheetFunctionsStrs_sfnSkew_P,	L"SKEW.P"
	dxSpreadSheetFunctionsStrs_sfnSkew_PDescription,	L"Returns the skewness of a distribution based on a population: a characterization of the degree of asymmetry of a distribution around its mean."
	dxSpreadSheetFunctionsStrs_sfnSlope,	L"SLOPE"
	dxSpreadSheetFunctionsStrs_sfnSlopeDescription,	L"Returns the slope of the linear regression line."
	dxSpreadSheetFunctionsStrs_sfnSmall,	L"SMALL"
	dxSpreadSheetFunctionsStrs_sfnSmallDescription,	L"Returns the K-th smallest value in a series of numeric values."
	dxSpreadSheetFunctionsStrs_sfnStandardize,	L"STANDARDIZE"
	dxSpreadSheetFunctionsStrs_sfnStandardizeDescription,	L"Returns a normalized value from a distribution characterized by the mean and standard deviation values."
	dxSpreadSheetFunctionsStrs_sfnStDev_P,	L"STDEV.P"
	dxSpreadSheetFunctionsStrs_sfnPercentRank_IncDescription,	L"Returns the percentage rank of the specified value in an array of numbers."
	dxSpreadSheetFunctionsStrs_sfnPermut,	L"PERMUT"
	dxSpreadSheetFunctionsStrs_sfnPermutDescription,	L"Returns the number of permutations for the specified number of objects."
	dxSpreadSheetFunctionsStrs_sfnPermutationA,	L"PERMUTATIONA"
	dxSpreadSheetFunctionsStrs_sfnPermutationADescription,	L"Returns the number of permutations for the specified number of objects (including repetitions) that can be selected from the total number of objects."
	dxSpreadSheetFunctionsStrs_sfnPHI,	L"PHI"
	dxSpreadSheetFunctionsStrs_sfnPHIDescription,	L"Returns the value of the density function for a standard normal distribution."
	dxSpreadSheetFunctionsStrs_sfnPoisson_Dist,	L"POISSON.DIST"
	dxSpreadSheetFunctionsStrs_sfnPoisson_DistDescription,	L"Returns the Poisson distribution that is often used to predict the number of events occurring over  a specific time."
	dxSpreadSheetFunctionsStrs_sfnProb,	L"PROB"
	dxSpreadSheetFunctionsStrs_sfnProbDescription,	L"Returns the probability that values in a range are between two limits."
	dxSpreadSheetFunctionsStrs_sfnQuartile_Exc,	L"QUARTILE.EXC"
	dxSpreadSheetFunctionsStrs_sfnQuartile_ExcDescription,	L"Returns the quartile of a series of numeric values, based on percentile values from the range between 0 and 1, exclusive."
	dxSpreadSheetFunctionsStrs_sfnQuartile_Inc,	L"QUARTILE.INC"
	dxSpreadSheetFunctionsStrs_sfnQuartile_IncDescription,	L"Returns the quartile of a series of numeric values."
	dxSpreadSheetFunctionsStrs_sfnRank_Avg,	L"RANK.AVG"
	dxSpreadSheetFunctionsStrs_sfnNorm_DistDescription,	L"Returns the normal distribution for the specified mean and standard deviation. This function is widely used in statistics, including hypothesis testing."
	dxSpreadSheetFunctionsStrs_sfnNorm_Inv,	L"NORM.INV"
	dxSpreadSheetFunctionsStrs_sfnNorm_InvDescription,	L"Iteratively calculates the inverse of the normal distribution for the specified mean and standard deviation."
	dxSpreadSheetFunctionsStrs_sfnNorm_S_Dist,	L"NORM.S.DIST"
	dxSpreadSheetFunctionsStrs_sfnNorm_S_DistDescription,	L"Returns the standard normal cumulative distribution function. The standard distribution\x2019s arithmetic mean and standard deviation are 0 and 1, respectively."
	dxSpreadSheetFunctionsStrs_sfnNorm_S_Inv,	L"NORM.S.INV"
	dxSpreadSheetFunctionsStrs_sfnNorm_S_InvDescription,	L"Iteratively calculates the inverse of the standard normal cumulative distribution. The standard distribution\x2019s arithmetic mean and standard deviation are 0 and 1, respectively."
	dxSpreadSheetFunctionsStrs_sfnPearson,	L"PEARSON"
	dxSpreadSheetFunctionsStrs_sfnPearsonDescription,	L"Returns the Pearson product moment correlation coefficient (R), a dimensionless index that ranges within the range between -1.0 and 1.0, inclusive, and reflects the extent of a linear relationship between two data sets."
	dxSpreadSheetFunctionsStrs_sfnPercentile_Exc,	L"PERCENTILE.EXC"
	dxSpreadSheetFunctionsStrs_sfnPercentile_ExcDescription,	L"Returns the K-th percentile of values in an array of numbers, where K is the range between 0 and 1, exclusive."
	dxSpreadSheetFunctionsStrs_sfnPercentile_Inc,	L"PERCENTILE.INC"
	dxSpreadSheetFunctionsStrs_sfnPercentile_IncDescription,	L"Returns the K-th percentile of values in an array of numbers."
	dxSpreadSheetFunctionsStrs_sfnPercentRank_Exc,	L"PERCENTRANK.EXC"
	dxSpreadSheetFunctionsStrs_sfnPercentRank_ExcDescription,	L"Returns the rank of a value in a data set as a percentage (0..1, exclusive) of a data set."
	dxSpreadSheetFunctionsStrs_sfnPercentRank_Inc,	L"PERCENTRANK.INC"
	dxSpreadSheetFunctionsStrs_sfnMaxDescription,	L"Returns the maximum value in an array of numeric values."
	dxSpreadSheetFunctionsStrs_sfnMaxA,	L"MAXA"
	dxSpreadSheetFunctionsStrs_sfnMaxADescription,	L"Returns the maximum value in an array, including numeric values, text, and logical values."
	dxSpreadSheetFunctionsStrs_sfnMedian,	L"MEDIAN"
	dxSpreadSheetFunctionsStrs_sfnMedianDescription,	L"Returns the median of a series of numeric values."
	dxSpreadSheetFunctionsStrs_sfnMin,	L"MIN"
	dxSpreadSheetFunctionsStrs_sfnMinDescription,	L"Returns the minimum value in an array of numeric values."
	dxSpreadSheetFunctionsStrs_sfnMinA,	L"MINA"
	dxSpreadSheetFunctionsStrs_sfnMinADescription,	L"Returns the minimum value in an array, including numeric values, text, and logical values."
	dxSpreadSheetFunctionsStrs_sfnMode_Mult,	L"MODE.MULT"
	dxSpreadSheetFunctionsStrs_sfnMode_MultDescription,	L"Returns a vertical array populated with the most frequently occurring (repetitive) values in an array of numeric values."
	dxSpreadSheetFunctionsStrs_sfnMode_SNGL,	L"MODE.SNGL"
	dxSpreadSheetFunctionsStrs_sfnMode_SNGLDescription,	L"Calculates the mode of a group of numbers, that is, returns the most frequently occurring (repetitive) value among all specified numeric values."
	dxSpreadSheetFunctionsStrs_sfnNegBinom_Dist,	L"NEGBINOM.DIST"
	dxSpreadSheetFunctionsStrs_sfnNegBinom_DistDescription,	L"Returns the negative binomial distribution, that is, the probability that there is a specific number of failures prior to achieving a threshold number of successful trials at the constant probability of success."
	dxSpreadSheetFunctionsStrs_sfnNorm_Dist,	L"NORM.DIST"
	dxSpreadSheetFunctionsStrs_sfnHypgeom_DistDescription,	L"Returns the hypergeometric distribution, that is, the probability of a specified number of sample successes at a specific sample size, number of population successes, and population size."
	dxSpreadSheetFunctionsStrs_sfnIntercept,	L"INTERCEPT"
	dxSpreadSheetFunctionsStrs_sfnInterceptDescription,	L"Calculates the point at which a line will intersect the Y-axis by using the known X and Y values. The intercept point is based on a best-fit regression line plotted through the known pairs of numeric values."
	dxSpreadSheetFunctionsStrs_sfnKurt,	L"KURT"
	dxSpreadSheetFunctionsStrs_sfnKurtDescription,	L"Returns the kurtosis of a series of numeric values. Kurtosis characterizes the relative peakedness or flatness of a distribution compared to the normal distribution. Positive kurtosis indicates a relatively peaked distribution. Negative kurtosis corresponds to a relatively flat distribution."
	dxSpreadSheetFunctionsStrs_sfnLarge,	L"LARGE"
	dxSpreadSheetFunctionsStrs_sfnLargeDescription,	L"Returns the K-th largest value in a series of numeric values."
	dxSpreadSheetFunctionsStrs_sfnLinest,	L"LINEST"
	dxSpreadSheetFunctionsStrs_sfnLinestDescription,	L"Calculates the statistics for a line by using the \x201cleast squares\x201d method to calculate a straight line that best fits your data, and returns an array that describes the line."
	dxSpreadSheetFunctionsStrs_sfnLogest,	L"LOGEST"
	dxSpreadSheetFunctionsStrs_sfnLogestDescription,	L"Calculates an exponential curve that fits your data and returns an array of values that describes the curve. This array function is used in regression analysis."
	dxSpreadSheetFunctionsStrs_sfnLogNorm_Dist,	L"LOGNORM.DIST"
	dxSpreadSheetFunctionsStrs_sfnLogNorm_DistDescription,	L"Returns the cumulative lognormal distribution."
	dxSpreadSheetFunctionsStrs_sfnLogNorm_Inv,	L"LOGNORM.INV"
	dxSpreadSheetFunctionsStrs_sfnLogNorm_InvDescription,	L"Calculates the inverse of the lognormal cumulative distribution."
	dxSpreadSheetFunctionsStrs_sfnMax,	L"MAX"
	dxSpreadSheetFunctionsStrs_sfnGamma_DistDescription,	L"Returns the gamma distribution. You can use this function to study a series of numbers that may have a skewed distribution. The gamma distribution is commonly used in queuing analysis."
	dxSpreadSheetFunctionsStrs_sfnGamma_Inv,	L"GAMMA.INV"
	dxSpreadSheetFunctionsStrs_sfnGamma_InvDescription,	L"Iteratively calculates the inverse of the gamma cumulative distribution. The gamma distribution is useful to study values that have a skewed distribution."
	dxSpreadSheetFunctionsStrs_sfnGammaLn,	L"GAMMALN"
	dxSpreadSheetFunctionsStrs_sfnGammaLnDescription,	L"Returns the natural logarithm of the Gamma function."
	dxSpreadSheetFunctionsStrs_sfnGammaLn_Precise,	L"GAMMALN.PRECISE"
	dxSpreadSheetFunctionsStrs_sfnGammaLn_PreciseDescription,	L"Returns the natural logarithm of the Gamma function (a high precision version)."
	dxSpreadSheetFunctionsStrs_sfnGauss,	L"GAUSS"
	dxSpreadSheetFunctionsStrs_sfnGaussDescription,	L"Calculates the probability that a member of a standard normal population is between the mean and Z standard deviation from the mean."
	dxSpreadSheetFunctionsStrs_sfnGeomean,	L"GEOMEAN"
	dxSpreadSheetFunctionsStrs_sfnGeomeanDescription,	L"Returns the geometric mean of an array of positive numeric values."
	dxSpreadSheetFunctionsStrs_sfnGrowth,	L"GROWTH"
	dxSpreadSheetFunctionsStrs_sfnGrowthDescription,	L"Calculates the predicted exponential growth by using the known numeric values."
	dxSpreadSheetFunctionsStrs_sfnHarmean,	L"HARMEAN"
	dxSpreadSheetFunctionsStrs_sfnHarmeanDescription,	L"Returns the harmonic mean of a series of numeric values. The harmonic mean is the reciprocal of the arithmetic mean of reciprocals."
	dxSpreadSheetFunctionsStrs_sfnHypgeom_Dist,	L"HYPGEOM.DIST"
	dxSpreadSheetFunctionsStrs_sfnF_InvDescription,	L"Returns the inverse of the F probability distribution."
	dxSpreadSheetFunctionsStrs_sfnF_Inv_RT,	L"F.INV.RT"
	dxSpreadSheetFunctionsStrs_sfnF_Inv_RTDescription,	L"Returns the inverse of the right-tailed F probability distribution. You can use the calculated result in an F-test to compare the degree of variability in two data sets."
	dxSpreadSheetFunctionsStrs_sfnF_Test,	L"F.TEST"
	dxSpreadSheetFunctionsStrs_sfnF_TestDescription,	L"Performs an F-test for two specified sets (arrays) of numeric values, returning the two-tailed probability that the variances in both arrays are similar."
	dxSpreadSheetFunctionsStrs_sfnFisher,	L"FISHER"
	dxSpreadSheetFunctionsStrs_sfnFisherDescription,	L"Returns the Fisher transformation."
	dxSpreadSheetFunctionsStrs_sfnFisherInv,	L"FISHERINV"
	dxSpreadSheetFunctionsStrs_sfnFisherInvDescription,	L"Returns the inverse of the Fisher transformation."
	dxSpreadSheetFunctionsStrs_sfnForecast,	L"FORECAST"
	dxSpreadSheetFunctionsStrs_sfnForecastDescription,	L"Forecasts a future value in a linear trend by using existing pairs of X and Y values."
	dxSpreadSheetFunctionsStrs_sfnFrequency,	L"FREQUENCY"
	dxSpreadSheetFunctionsStrs_sfnFrequencyDescription,	L"Returns a frequency distribution as a vertical array."
	dxSpreadSheetFunctionsStrs_sfnGamma,	L"GAMMA"
	dxSpreadSheetFunctionsStrs_sfnGammaDescription,	L"Returns the Gamma function value."
	dxSpreadSheetFunctionsStrs_sfnGamma_Dist,	L"GAMMA.DIST"
	dxSpreadSheetFunctionsStrs_sfnCountIFDescription,	L"Returns the number of cells within the specified range that meet a specific criterion."
	dxSpreadSheetFunctionsStrs_sfnCountIFS,	L"COUNTIFS"
	dxSpreadSheetFunctionsStrs_sfnCountIFSDescription,	L"Returns the number of cells within the specified range that meet multiple criteria."
	dxSpreadSheetFunctionsStrs_sfnCovariance_P,	L"COVARIANCE.P"
	dxSpreadSheetFunctionsStrs_sfnCovariance_PDescription,	L"Calculates the population average of the products of deviations (that is, population covariance) for each pair of values in the specified series of numeric values."
	dxSpreadSheetFunctionsStrs_sfnCovariance_S,	L"COVARIANCE.S"
	dxSpreadSheetFunctionsStrs_sfnCovariance_SDescription,	L"Calculates the sample average of the products of deviations (that is, sample covariance) for each pair of values in the specified series of numeric values."
	dxSpreadSheetFunctionsStrs_sfnDevSQ,	L"DEVSQ"
	dxSpreadSheetFunctionsStrs_sfnDevSQDescription,	L"Returns the sum of squares of deviations of a numbers in an array from their sample mean."
	dxSpreadSheetFunctionsStrs_sfnExpon_Dist,	L"EXPON.DIST"
	dxSpreadSheetFunctionsStrs_sfnExpon_DistDescription,	L"Returns the exponential distribution. This function is useful if you need to evaluate the process duration probabilities."
	dxSpreadSheetFunctionsStrs_sfnF_Dist,	L"F.DIST"
	dxSpreadSheetFunctionsStrs_sfnF_DistDescription,	L"Returns the F probability distribution."
	dxSpreadSheetFunctionsStrs_sfnF_Dist_RT,	L"F.DIST.RT"
	dxSpreadSheetFunctionsStrs_sfnF_Dist_RTDescription,	L"Returns the right-tailed F probability distribution. This function is useful if you need to identify if two data sets have different degrees of diversity."
	dxSpreadSheetFunctionsStrs_sfnF_Inv,	L"F.INV"
	dxSpreadSheetFunctionsStrs_sfnChiSQ_Inv_RTDescription,	L"Iteratively calculates the inverse of the right-tailed probability of the chi-squared distribution."
	dxSpreadSheetFunctionsStrs_sfnChiSQ_Test,	L"CHISQ.TEST"
	dxSpreadSheetFunctionsStrs_sfnChiSQ_TestDescription,	L"Returns the test for independence as the value from the chi-squared distribution for the statistic and the appropriate degrees of freedom. You can use this function to identify if the specific hypothesis results are verified by an experiment."
	dxSpreadSheetFunctionsStrs_sfnConfidence_Norm,	L"CONFIDENCE.NORM"
	dxSpreadSheetFunctionsStrs_sfnConfidence_NormDescription,	L"Returns the confidence interval for a population mean using a normal distribution."
	dxSpreadSheetFunctionsStrs_sfnConfidence_T,	L"CONFIDENCE.T"
	dxSpreadSheetFunctionsStrs_sfnConfidence_TDescription,	L"Returns the confidence interval for a population mean using a Student\x2019s T-distribution."
	dxSpreadSheetFunctionsStrs_sfnCorrel,	L"CORREL"
	dxSpreadSheetFunctionsStrs_sfnCorrelDescription,	L"Returns the correlation coefficient between two specified arrays of numeric values. Use this function to determine the relationship between data sets."
	dxSpreadSheetFunctionsStrs_sfnCount,	L"COUNT"
	dxSpreadSheetFunctionsStrs_sfnCountDescription,	L"Returns the number of cells that contain numbers or the total number of numeric values within the specified array."
	dxSpreadSheetFunctionsStrs_sfnCountA,	L"COUNTA"
	dxSpreadSheetFunctionsStrs_sfnCountADescription,	L"Returns the total number of non-empty cells within the specified cell range."
	dxSpreadSheetFunctionsStrs_sfnCountBlank,	L"COUNTBLANK"
	dxSpreadSheetFunctionsStrs_sfnCountBlankDescription,	L"Returns the total number of blank cells within the specified cell range."
	dxSpreadSheetFunctionsStrs_sfnCountIF,	L"COUNTIF"
	dxSpreadSheetFunctionsStrs_sfnBeta_DistDescription,	L"Returns the cumulative beta probability density distribution. The beta distribution is useful to study variation of a specific indicator (as a percentage) across samples."
	dxSpreadSheetFunctionsStrs_sfnBeta_Inv,	L"BETA.INV"
	dxSpreadSheetFunctionsStrs_sfnBeta_InvDescription,	L"Returns the inverse of the cumulative beta probability density function for the specified beta distribution probability."
	dxSpreadSheetFunctionsStrs_sfnBinom_Dist,	L"BINOM.DIST"
	dxSpreadSheetFunctionsStrs_sfnBinom_DistDescription,	L"Returns the individual term binomial distribution probability. You can use this function to evaluate a fixed number of independent trials that can result only in success or failure, provided that the probability of success does not change throughout the experiment."
	dxSpreadSheetFunctionsStrs_sfnBinom_Dist_Range,	L"BINOM.DIST.RANGE"
	dxSpreadSheetFunctionsStrs_sfnBinom_Dist_RangeDescription,	L"Returns the probability of a trial\x2019s result by using a binomial distribution."
	dxSpreadSheetFunctionsStrs_sfnBinom_Inv,	L"BINOM.INV"
	dxSpreadSheetFunctionsStrs_sfnBinom_InvDescription,	L"Returns the smallest value for which the cumulative binomial distribution is greater than or equals a criterion value."
	dxSpreadSheetFunctionsStrs_sfnChiSQ_Dist,	L"CHISQ.DIST"
	dxSpreadSheetFunctionsStrs_sfnChiSQ_DistDescription,	L"Returns the chi-squared distribution which is commonly used to study variation in the percentage of a specific indicator across samples."
	dxSpreadSheetFunctionsStrs_sfnChiSQ_Dist_RT,	L"CHISQ.DIST.RT"
	dxSpreadSheetFunctionsStrs_sfnChiSQ_Dist_RTDescription,	L"Returns the right-tailed probability of the chi-squared distribution. You can use this function to calculate the variation of a certain indicator across the experimental data."
	dxSpreadSheetFunctionsStrs_sfnChiSQ_Inv,	L"CHISQ.INV"
	dxSpreadSheetFunctionsStrs_sfnChiSQ_InvDescription,	L"Returns the inverse of the left-tailed probability of the chi-squared distribution."
	dxSpreadSheetFunctionsStrs_sfnChiSQ_Inv_RT,	L"CHISQ.INV.RT"
	dxSpreadSheetFunctionsStrs_sfnUniCodeDescription,	L"Returns the code corresponding to the first character in the specified text string."
	dxSpreadSheetFunctionsStrs_sfnUpper,	L"UPPER"
	dxSpreadSheetFunctionsStrs_sfnUpperDescription,	L"Converts a text string to uppercase."
	dxSpreadSheetFunctionsStrs_sfnValue,	L"VALUE"
	dxSpreadSheetFunctionsStrs_sfnValueDescription,	L"Converts a text string to a numeric value."
	dxSpreadSheetFunctionsStrs_sfnAveDev,	L"AVEDEV"
	dxSpreadSheetFunctionsStrs_sfnAveDevDescription,	L"Returns the average of the absolute deviations of a numeric value series from their mean. The calculated value is a measure of the data set variability."
	dxSpreadSheetFunctionsStrs_sfnAverage,	L"AVERAGE"
	dxSpreadSheetFunctionsStrs_sfnAverageDescription,	L"Calculates the average value of a numeric value series."
	dxSpreadSheetFunctionsStrs_sfnAverageA,	L"AVERAGEA"
	dxSpreadSheetFunctionsStrs_sfnAverageADescription,	L"Calculates the average value of numeric values in all non-empty cells."
	dxSpreadSheetFunctionsStrs_sfnAverageIF,	L"AVERAGEIF"
	dxSpreadSheetFunctionsStrs_sfnAverageIFDescription,	L"Returns the average (that is, the arithmetic mean) of all cells within the cell range that meet a specific criterion."
	dxSpreadSheetFunctionsStrs_sfnAverageIFS,	L"AVERAGEIFS"
	dxSpreadSheetFunctionsStrs_sfnAverageIFSDescription,	L"Returns the average (that is, the arithmetic mean) of all cells that meet multiple criteria."
	dxSpreadSheetFunctionsStrs_sfnBeta_Dist,	L"BETA.DIST"
	dxSpreadSheetFunctionsStrs_sfnRightBDescription,	L"Returns one or more last characters in a text string. The double-byte version."
	dxSpreadSheetFunctionsStrs_sfnSearch,	L"SEARCH"
	dxSpreadSheetFunctionsStrs_sfnSearchDescription,	L"Searches one text string within another. The single-byte version."
	dxSpreadSheetFunctionsStrs_sfnSearchB,	L"SEARCHB"
	dxSpreadSheetFunctionsStrs_sfnSearchBDescription,	L"Searches one text string within another. The double-byte version."
	dxSpreadSheetFunctionsStrs_sfnSubstitute,	L"SUBSTITUTE"
	dxSpreadSheetFunctionsStrs_sfnSubstituteDescription,	L"Substitutes a specific text with another text in a string."
	dxSpreadSheetFunctionsStrs_sfnT,	L"T"
	dxSpreadSheetFunctionsStrs_sfnTDescription,	L"Returns text to which the specified value refers."
	dxSpreadSheetFunctionsStrs_sfnText,	L"TEXT"
	dxSpreadSheetFunctionsStrs_sfnTextDescription,	L"Formats a specific value as text."
	dxSpreadSheetFunctionsStrs_sfnTrim,	L"TRIM"
	dxSpreadSheetFunctionsStrs_sfnTrimDescription,	L"Removes all spaces from text, except for single spaces between individual words."
	dxSpreadSheetFunctionsStrs_sfnUniChar,	L"UNICHAR"
	dxSpreadSheetFunctionsStrs_sfnUniCharDescription,	L"Returns the character corresponding to the specified number in the Unicode table."
	dxSpreadSheetFunctionsStrs_sfnUniCode,	L"UNICODE"
	dxSpreadSheetFunctionsStrs_sfnMidBDescription,	L"Returns the substring of the specified text string. The double-byte version."
	dxSpreadSheetFunctionsStrs_sfnNumberValue,	L"NUMBERVALUE"
	dxSpreadSheetFunctionsStrs_sfnNumberValueDescription,	L"Converts text to a number using a locale-independent algorithm."
	dxSpreadSheetFunctionsStrs_sfnPhonetic,	L"PHONETIC"
	dxSpreadSheetFunctionsStrs_sfnPhoneticDescription,	L"Extracts the phonetic (furigana) characters from a text string."
	dxSpreadSheetFunctionsStrs_sfnProper,	L"PROPER"
	dxSpreadSheetFunctionsStrs_sfnProperDescription,	L"Capitalizes the first letter in a text string and any other letters that follow any non-letter character. Converts all other letters to lowercase."
	dxSpreadSheetFunctionsStrs_sfnReplace,	L"REPLACE"
	dxSpreadSheetFunctionsStrs_sfnReplaceDescription,	L"Replaces a part of a text string with the specified text, based on the provided text size and character position. The single-byte version."
	dxSpreadSheetFunctionsStrs_sfnReplaceB,	L"REPLACEB"
	dxSpreadSheetFunctionsStrs_sfnReplaceBDescription,	L"Replaces a part of a text string with the specified text, based on the provided text size and character position. The double-byte version."
	dxSpreadSheetFunctionsStrs_sfnRept,	L"REPT"
	dxSpreadSheetFunctionsStrs_sfnReptDescription,	L"Repeats the text string a specific number of times."
	dxSpreadSheetFunctionsStrs_sfnRight,	L"RIGHT"
	dxSpreadSheetFunctionsStrs_sfnRightDescription,	L"Returns one or more last characters in a text string. The single-byte version."
	dxSpreadSheetFunctionsStrs_sfnRightB,	L"RIGHTB"
	dxSpreadSheetFunctionsStrs_sfnFindBDescription,	L"Locates one text string within a second text string, and returns the number of the starting position of the first text string from the first character of the second text string. The double-byte version."
	dxSpreadSheetFunctionsStrs_sfnFixed,	L"FIXED"
	dxSpreadSheetFunctionsStrs_sfnFixedDescription,	L"Rounds the first parameter to the number of decimals determined by the second parameter and returns it as a string. The third parameter specifies whether to omit commas in the output string."
	dxSpreadSheetFunctionsStrs_sfnLeft,	L"LEFT"
	dxSpreadSheetFunctionsStrs_sfnLeftDescription,	L"Returns the first character or characters in a text string. The second parameter defines the number of characters to extract. The single-byte version."
	dxSpreadSheetFunctionsStrs_sfnLeftB,	L"LEFTB"
	dxSpreadSheetFunctionsStrs_sfnLeftBDescription,	L"Returns the first character or characters in a text string. The second parameter defines the number of characters to extract. The double-byte version."
	dxSpreadSheetFunctionsStrs_sfnLen,	L"LEN"
	dxSpreadSheetFunctionsStrs_sfnLenDescription,	L"Returns the specified text string\x2019s length, in characters. The single-byte version."
	dxSpreadSheetFunctionsStrs_sfnLenB,	L"LENB"
	dxSpreadSheetFunctionsStrs_sfnLenBDescription,	L"Returns the specified text string\x2019s length, in characters. The double-byte version."
	dxSpreadSheetFunctionsStrs_sfnLower,	L"LOWER"
	dxSpreadSheetFunctionsStrs_sfnLowerDescription,	L"Converts a text string to lowercase."
	dxSpreadSheetFunctionsStrs_sfnMid,	L"MID"
	dxSpreadSheetFunctionsStrs_sfnMidDescription,	L"Returns the substring of the specified text string. The single-byte version."
	dxSpreadSheetFunctionsStrs_sfnMidB,	L"MIDB"
	dxSpreadSheetFunctionsStrs_sfnCharDescription,	L"Returns the character specified y a number. Use CHAR to translate code page numbers you might get from files on other types of computers into characters."
	dxSpreadSheetFunctionsStrs_sfnClean,	L"CLEAN"
	dxSpreadSheetFunctionsStrs_sfnCleanDescription,	L"Removes all non-printable characters from text. Use CLEAN on text imported from other applications that contains characters that may not print with your operating system."
	dxSpreadSheetFunctionsStrs_sfnCode,	L"CODE"
	dxSpreadSheetFunctionsStrs_sfnCodeDescription,	L"Returns a numeric code for the first character in a text string. The returned code corresponds to the character set used by your computer."
	dxSpreadSheetFunctionsStrs_sfnConcatenate,	L"CONCATENATE"
	dxSpreadSheetFunctionsStrs_sfnConcatenateDescription,	L"Joins several text strings in one text string. An alternative to \x201c&\x201d."
	dxSpreadSheetFunctionsStrs_sfnDBCS,	L"DBCS"

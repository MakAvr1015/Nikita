	dxSpreadSheetFunctionsStrs_sfnHour,	L"HOUR"
	dxSpreadSheetFunctionsStrs_sfnHourDescription,	L"Converts a serial number to the corresponding hour."
	dxSpreadSheetFunctionsStrs_sfnIsoWeekNum,	L"ISOWEEKNUM"
	dxSpreadSheetFunctionsStrs_sfnIsoWeekNumDescription,	L"Returns the ISO number of the week to which the specified date belongs."
	dxSpreadSheetFunctionsStrs_sfnTDist,	L"TDIST"
	dxSpreadSheetFunctionsStrs_sfnTDistDescription,	L"Returns the Percentage Points (that is, the probability) for the Student T-distribution. The T-distribution is used in the hypothesis testing of small sample data sets."
	dxSpreadSheetFunctionsStrs_sfnTInv,	L"TINV"
	dxSpreadSheetFunctionsStrs_sfnTInvDescription,	L"Iteratively calculates the two-tailed inverse of the Student\x2019s T-distribution."
	dxSpreadSheetFunctionsStrs_sfnTTest,	L"TTEST"
	dxSpreadSheetFunctionsStrs_sfnTTestDescription,	L"Returns the probability associated with a Student\x2019s T-test."
	dxSpreadSheetFunctionsStrs_sfnVar,	L"VAR"
	dxSpreadSheetFunctionsStrs_sfnVarDescription,	L"Estimates variance based on the specified array of numeric values (a sample of the population)."

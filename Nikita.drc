	dxSpreadSheetFunctionsStrs_sfnCoupNCD,	L"COUPNCD"
	dxSpreadSheetFunctionsStrs_sfnCoupNCDDescription,	L"Returns the next coupon date after the settlement date."
	dxSpreadSheetFunctionsStrs_sfnCoupNum,	L"COUPNUM"
	dxSpreadSheetFunctionsStrs_sfnCoupNumDescription,	L"Returns the number of coupons payable between the settlement date and maturity date."
	dxSpreadSheetFunctionsStrs_sfnToday,	L"TODAY"
	dxSpreadSheetFunctionsStrs_sfnTodayDescription,	L"Returns the serial number corresponding to the current date."

	dxSpreadSheetFunctionsStrs_sfnWeekNum,	L"WEEKNUM"
	dxSpreadSheetFunctionsStrs_sfnWeekNumDescription,	L"Returns the week number corresponding to the specified date."
	dxSpreadSheetFunctionsStrs_sfnWorkDay,	L"WORKDAY"
	dxSpreadSheetFunctionsStrs_sfnWorkDayDescription,	L"Returns the workday separated from the initial date by the specified number of workdays. The returned day precedes or follows the initial date, depending on the day count\x2019s sign."
	dxSpreadSheetFunctionsStrs_sfnWorkDay_Intl,	L"WORKDAY.INTL"
	dxSpreadSheetFunctionsStrs_sfnWorkDay_IntlDescription,	L"Returns the serial number of the date before or after the specified number of workdays, taking a custom set of holidays into account."
	dxSpreadSheetFunctionsStrs_sfnYear,	L"YEAR"
	dxSpreadSheetFunctionsStrs_sfnYearDescription,	L"Returns the serial number corresponding to the specified year."
	dxSpreadSheetFunctionsStrs_sfnYearFrac,	L"YEARFRAC"
	dxSpreadSheetFunctionsStrs_sfnYearFracDescription,	L"Calculates the fraction of the year within the range between two specified dates."
	dxSpreadSheetFunctionsStrs_sfnAccrInt,	L"ACCRINT"
	dxSpreadSheetFunctionsStrs_sfnIsoWeekNumDescription,	L"Returns the ISO number of the week to which the specified date belongs."
	dxSpreadSheetFunctionsStrs_sfnMinute,	L"MINUTE"
	dxSpreadSheetFunctionsStrs_sfnMinuteDescription,	L"Converts a serial number to the corresponding minute."
	dxSpreadSheetFunctionsStrs_sfnMonth,	L"MONTH"
	dxSpreadSheetFunctionsStrs_sfnMonthDescription,	L"Converts a serial number to the corresponding month."
